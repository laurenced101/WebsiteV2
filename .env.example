# Copy to .env and fill in. Never commit the real .env (it's gitignored).
#
# NOTION_API_KEY — internal-integration token (starts with "ntn_") created at
# https://www.notion.so/profile/integrations with the "Projects V2" database
# shared to it (••• menu → Connections → add the integration).
# Used by scripts/fetch-projects.mjs at build time. On Vercel, set this in the
# project's Environment Variables instead of via a file.
NOTION_API_KEY=

# STUDIES_PASSWORD — password for the /studies gate (src/middleware.ts). Validated
# server-side; never shipped to the browser. Set locally here and in the Vercel
# project's Environment Variables (Production + Preview) for the deployed site.
STUDIES_PASSWORD=
