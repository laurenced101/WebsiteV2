---
// BaseLayout.astro — wraps every page with global styles, navbar + footer.
// Usage: <BaseLayout title="/experience" active="experience"> ... </BaseLayout>
import { Font } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = 'laurence-dawes.design', active } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <Font cssVariable="--font-space-grotesk" preload />
  </head>
  <body>
    <Navbar active={active} />
    <main class="page-main"><slot /></main>
    <Footer />
  </body>
</html>
