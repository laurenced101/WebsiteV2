---
// about.astro — the ABOUT page. At-parity port of the live (Figma Sites) ABOUT
// page. Copy + image references are hardcoded here (same posture as HOME) rather
// than pulled from Notion — ABOUT is a single static page that changes a handful
// of times a year, so a Notion content pipeline isn't worth its complexity.
//
// Images live in /public/about/ (section photos) and /public/about/clients/
// (logo wall), committed locally — no external/signed-URL dependencies. The blue
// duotone on the photos is NOT the baked-in treatment from the source files: it's
// driven in CSS (saturation filter + a blend-mode overlay, the `.duo` class) so
// the blue is token-controlled. Client logos keep their own (baked) treatment.
import BaseLayout from '../layouts/BaseLayout.astro';

// Client-logo wall — live reading order (left→right, top→bottom). Files are
// BLACK wordmarks (transparent PNG) in /public/about/clients/; the blue look is a
// CSS treatment (a blue linear-gradient set to `mix-blend-mode: lighten` over a
// light tile — see .about-client below), so black marks read blue, light bg stays
// light. Duran Duran dropped (#22) → 24 logos, 5-up.
const clients = [
  { name: 'Mattel', file: 'mattel.png' },
  { name: 'Black Eyed Peas', file: 'black-eyed-peas.png' },
  { name: 'Meta', file: 'meta.png' },
  { name: 'LEGO', file: 'lego.png' },
  { name: 'Google', file: 'google.png' },
  { name: 'Snapchat', file: 'snapchat.png' },
  { name: 'Twitch', file: 'twitch.png' },
  { name: 'Disney', file: 'disney.png' },
  { name: 'Niantic', file: 'niantic.png' },
  { name: 'FOX', file: 'fox.png', preTinted: true },   // Figma fill is clipped; this is the cell render (already blue) → skip the CSS tint
  { name: 'Qualcomm', file: 'qualcomm.png' },
  { name: 'Nike', file: 'nike.png' },
  { name: 'Unity', file: 'unity.png' },
  { name: 'Roblox', file: 'roblox.png' },
  { name: 'Bose', file: 'bose.png' },
  { name: 'Verizon', file: 'verizon.png' },
  { name: 'Samsung', file: 'samsung.png' },
  { name: 'GE', file: 'ge.png' },
  { name: 'Amazon', file: 'amazon.png' },
  { name: 'NHL', file: 'nhl.png' },
  { name: 'Comcast', file: 'comcast.png' },
  { name: 'AT&T', file: 'att.png' },
  { name: 'Whirlpool', file: 'whirlpool.png' },
  { name: 'Morgan Stanley', file: 'morgan-stanley.png' },
];
---
<BaseLayout title="/about" active="about">
  <!-- HERO — full-bleed 85vh portrait (flush to navbar), title centred over it.
       Title sits in a .wrap so it aligns to the content column. -->
  <section class="about-hero">
    <figure class="duo about-hero-media"><img src="/about/hero.jpg" alt="Portrait of Laurence Dawes" /></figure>
    <div class="wrap about-hero-inner"><h1 class="about-hero-title reveal">/about</h1></div>
  </section>

  <!-- INTRO -->
  <section class="about-intro">
    <div class="wrap">
      <p>Laurence is a design leader with over 20 years experience living and working in Los Angeles, California. Specializing in leading diverse creative teams, he&rsquo;s currently immersed in the worlds of augmented reality and AI, unifying the two to create experiences indicative of a new future of human interaction.</p>
      <p>Hailing from the UK, Laurence grew up with an innate curiosity to create &amp; build. The English countryside where he spent his childhood offered a boundless playground for exploration - whether building treehouses or connecting LEGO bricks, many a day was spent problem solving and turning creative ideas into tangible reality. These early sparks manifested toward studying industrial design as a practice in the south of England and then onto developing world class toy and play experiences in Denmark. This in turn saw Laurence move toward digital product and experience design, experimenting and creating within a wide variety of mediums.</p>
    </div>
  </section>

  <!-- PHYSICAL PLAY -->
  <section class="about-section">
    <div class="wrap">
      <h2>Physical play</h2>
      <p>In 2006 Laurence joined LEGO to design and develop new toy products for children across the globe. This journey saw him work with physical product development and 2D &amp; 3D design languages, honing his craft with an emphasis on detail and attentiveness in design. The LEGO motto of &rdquo;det bedste er ikke for godt&rdquo; (only the best is good enough) resonated deeply and has remained a guiding principle in Laurence&rsquo;s work to date.</p>
      <p>Throughout this journey, Laurence led multi-disciplined teams working on flagship product launches and in latter years exploring new worlds of digital-physical play experience, spurned by new advances in mobile technology, gaming &amp; augmented reality.</p>
      <div class="about-figrow">
        <figure class="duo"><img src="/about/physical-1.jpg" alt="" /></figure>
        <figure class="duo"><img src="/about/physical-2.jpg" alt="" /></figure>
      </div>
    </div>
  </section>

  <!-- DIGITAL EXPERIENCES -->
  <section class="about-section">
    <div class="wrap">
      <h2>Digital experiences</h2>
      <p>This exploration in new digital dimensions led Laurence to join Trigger XR in 2015, transitioning to working fully in the realm of digital &amp; immersive experiences. With a focus on AR, VR and their adjacent technologies, Laurence led the conception and development of numerous mobile AR, VR &amp; location-based experiences again leading diverse teams to come up with industry-leading and often groundbreaking products. Wearing many hats, Laurence&rsquo;s role covered innovation, strategy, client development &amp; people leadership, initially leading Trigger XR&rsquo;s European base in Denmark before moving to the U.S. in 2019 to focus on building a specialist innovation team and work ever more closely with key brand &amp; client partners.</p>
      <div class="about-figrow">
        <figure class="duo"><img src="/about/digital-1.jpg" alt="" /></figure>
        <figure class="duo"><img src="/about/digital-2.jpg" alt="" /></figure>
      </div>
    </div>
  </section>

  <!-- LEADING COLLABORATION + CLIENT WALL -->
  <section class="about-section">
    <div class="wrap">
      <h2>Leading collaboration</h2>
      <p>Throughout his career Laurence has collaborated with many companies &amp; brands primarily in innovation-focused projects exploring the application of new technologies to business and brand objectives. Covering a wide variety of verticals, Laurence has extensive experience working closely and quickly within innovation and creative teams to give birth to truly forward-thinking work - whether inspiring the imagination of existing audiences totaling in the millions globally, or seeking to capture the attention of new audiences through never-seen-before experiences, Laurence thrives in high-collaboration environments.</p>
      <div class="about-clients">
        {clients.map((c) => (
          <div class:list={['about-client', c.preTinted && 'is-pretinted']}><img src={`/about/clients/${c.file}`} alt={c.name} loading="lazy" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- AWARDS & PATENTS -->
  <section class="about-section about-section--last">
    <div class="wrap">
      <h2>Awards &amp; patents</h2>
      <p>Laurence has received a number of awards for his work in physical products &amp; digital experiences, including SXSW, Toy Of The Year, Webby &amp; CES Innovation awards among others.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The `.duo` duotone treatment on the hero + section photos is the shared
     utility in global.css (knobs in tokens.css). Figures just add the class. */

  /* ===== HERO ===== */
  /* 85vh, flush to the navbar (see is:global page-top-gap override below). */
  .about-hero {
    position: relative;
    height: var(--hero-height);
  }
  .about-hero-media {
    position: absolute;
    inset: 0;
  }
  .about-hero-media img {
    height: 100%;
    object-fit: cover;
    object-position: right center;  /* keep the portrait on the right; crop the left edge (Figma) */
  }
  .about-hero-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;            /* title vertically centred in the hero */
    justify-content: center;        /* horizontally centred (Desktop/Large/Tablet); mobile → left */
  }
  .about-hero-title {
    /* Smaller than the page h1 (Ticket 22), centred over the hero. Per-breakpoint
       fixed sizes — a one-off hero treatment, not a global type role. */
    font-size: 48px;
    font-weight: var(--weight-h1);
    line-height: var(--leading-h1);
    letter-spacing: 0.15em;          /* much wider tracking on the page heading */
    text-align: center;
    /* On the blue hero the brand-blue h1 colour would vanish — set in the surface
       colour so it reads as the white overlay the live page uses. */
    color: var(--surface);
  }
  @media (min-width: 1800px) { .about-hero-title { font-size: 56px; } }

  /* ===== INTRO ===== */
  /* Generous gaps around the intro: cover image → first paragraph (padding-top)
     and first paragraph → Physical play heading (padding-bottom), both bumped
     per Figma feedback. */
  .about-intro .wrap { padding-top: var(--space-128); padding-bottom: var(--space-96); }
  .about-intro p {
    font-size: var(--font-size-body);   /* body role per Figma (was an h3 lede) */
    font-weight: var(--weight-body);
    line-height: var(--leading-body);
    color: var(--text-body);
  }
  .about-intro p + p { margin-top: var(--space-24); }

  /* ===== SECTIONS ===== */
  /* More breathing room between sections (Figma feedback: "larger gap here"). */
  .about-section .wrap { padding-bottom: var(--space-128); }
  /* Much larger gap before the footer (Figma). */
  .about-section--last .wrap { padding-bottom: var(--space-240); }
  /* Section headings sized to the h3 role (Figma), kept brand-blue (the h3 role
     colour is ink, so colour is set explicitly). */
  .about-section h2 {
    font-size: var(--font-size-h3);
    font-weight: var(--weight-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
    color: var(--color-primary);
    /* More space heading → body (Figma feedback: "larger gap here"). */
    margin-bottom: var(--space-32);
  }
  .about-section p {
    font-size: var(--font-size-body);
    font-weight: var(--weight-body);
    line-height: var(--leading-body);
    color: var(--text-body);
  }
  .about-section p + p { margin-top: var(--space-16); }

  /* ===== BLOG BODY-WIDTH (Ticket 22) =====
     Prose (intro + section headings/text) is constrained to the blog measure and
     centred within the content width; media (image rows + client wall) stays full
     content width. Desktop/Large only — Tablet/Mobile run prose full width (the
     cap is removed in the ≤1279 block). */
  .about-intro p,
  .about-section h2,
  .about-section p {
    max-width: var(--layout-max-width-blog);
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== IMAGE ROWS ===== */
  /* Two photos side by side at natural aspect, tops aligned. */
  .about-figrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-24);
    align-items: start;
    /* More space above the image pair (Figma feedback: "larger gap here"). */
    margin-top: var(--space-48);
  }

  /* ===== CLIENT WALL ===== */
  /* Full content width, 5-up. Logos are BLACK wordmarks (transparent PNG); the blue
     look is the Figma treatment replicated in CSS: a per-cell blue linear-gradient
     set to mix-blend-mode: lighten over a light tile. Lighten keeps the lighter of
     each channel, so the near-white tile stays put while the black mark takes the
     blue. `isolation: isolate` scopes the blend to the cell (the tile is its own
     backdrop) so it can't bleed onto the page. */
  .about-clients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));   /* 4-up every breakpoint; minmax(0,…) lets cells shrink so logos scale down rather than overflow on mobile */
    gap: var(--space-24);
    margin-top: var(--space-96);    /* larger gap before the wall (Figma) */
    /* Match the prose body width (blog measure), centred — Desktop/Large only.
       Tablet/Mobile run full content width (cap removed in the ≤1279 block). */
    max-width: var(--layout-max-width-blog);
    margin-left: auto;
    margin-right: auto;
  }
  .about-client {
    position: relative;
    isolation: isolate;
    background: var(--surface);
    height: 84px;                   /* logo-wall cell — deliberate constant (cf. /experience wall) */
    min-width: 0;                   /* allow the grid cell to shrink below the logo's intrinsic width (no overflow) */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16);
  }
  .about-client img {
    width: auto;
    height: auto;
    min-width: 0;                   /* let the (flex-item) logo shrink below its intrinsic width */
    max-width: 80%;
    max-height: 56px;               /* deliberate logo cap */
    object-fit: contain;
  }
  .about-client::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Exact Figma gradient (left→right); lighter than --color-primary by design. */
    background: linear-gradient(to right, #5252f5, #2727f5);
    mix-blend-mode: lighten;
    pointer-events: none;
  }
  /* FOX is already blue (cell-render fallback — its black source is clipped),
     so it doesn't get the blue lighten overlay. It's also a chunky, near-square
     mark, so cap it narrower than the others to match their visual weight. */
  .about-client.is-pretinted::after { content: none; }
  .about-client.is-pretinted img { max-width: 60%; }

  /* ===== TABLET (≤1279) ===== */
  @media (max-width: 1279px) {
    .about-hero-title { font-size: 40px; }
    /* Prose runs full content width below desktop (blog cap is Desktop/Large only). */
    .about-intro p,
    .about-section h2,
    .about-section p { max-width: none; margin-left: 0; margin-right: 0; }
    /* wall stays 4-up; runs full content width below desktop (matches the prose) */
    .about-clients { max-width: none; margin-left: 0; margin-right: 0; }
  }

  /* ===== MOBILE (≤800) ===== */
  @media (max-width: 800px) {
    .about-hero-inner { justify-content: flex-start; }   /* hero title left-aligned on mobile */
    .about-hero-title { font-size: 32px; text-align: left; }
    .about-figrow { grid-template-columns: 1fr; gap: var(--space-16); }
    /* wall stays 4-up; tighten the cells so 4 fit at 375 */
    .about-clients { gap: var(--space-12); }
    .about-client { height: 64px; padding: var(--space-8); }
    .about-client img { max-height: 36px; max-width: 90%; }
  }
</style>

<style is:global>
  /* ABOUT hero touches the navbar — no top gap (a unique setting for this page,
     per Figma #17). Override the site-wide page-top-gap to 0 on this route only;
     set on .page-main itself, where global.css reads it for padding-top. */
  .page-main { --page-top-gap: 0px; }
</style>
