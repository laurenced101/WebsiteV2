---
// index.astro — the HOME page. Ported from home-prototype_1.html, with the real
// tuned static-treatment slideshow (HomeSlideshow) in the hero placement instead
// of the prototype's plain crossfade placeholder. Navbar + footer come from
// BaseLayout; the standalone prototype's <nav>/<footer> markup is not ported.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSlideshow from '../components/HomeSlideshow.astro';
import HomePillar from '../components/HomePillar.astro';
---
<BaseLayout title="laurence-dawes.design">
  <!-- HERO SLIDESHOW — contained 16:9 on desktop/large (matches Figma, inset);
       full-bleed 75vh on tablet/mobile. -->
  <section class="hero">
    <div class="hero-inner"><HomeSlideshow /></div>
  </section>

  <!-- STATEMENT -->
  <section class="home-statement">
    <div class="wrap">
      <p>An award-winning design leader working at the juncture of <span class="link">design</span>, <span class="link">technology</span> &amp; <span class="link">strategy</span>.</p>
      <p>Currently working with AI &amp; XR technology, Laurence has built many groundbreaking products and experiences together with industry leaders such as <span class="link">LEGO</span>, <span class="link">Google</span>, <span class="link">Disney</span>, <span class="link">Bose</span> and <span class="link">Niantic</span>, to name a few.</p>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="pillars">
    <div class="wrap">
      <HomePillar heading="/design_leadership" image="/Workshop2.webp">
        <p>Two decades leading multi-disciplinary teams across LEGO, Trigger XR and AI/XR-native organisations — taking ideas from earliest concept through to global launch. Building creative cultures, mentoring talent, and shaping product vision in spaces where the technology often hasn't been invented yet.</p>
      </HomePillar>

      <HomePillar heading="/strategy" image="/Spectator1.webp">
        <p>Connecting emerging technology to brand opportunity. Building innovation roadmaps for partners including Bose, Niantic and Google — finding where R&amp;D capability, audience need and commercial reality intersect, and turning that into work that ships.</p>
      </HomePillar>

      <HomePillar heading="/product_&_experience" image="/Coach1.webp">
        <p>Hands-on design of physical play products, AR experiences and immersive installations. From LEGO toy lines reaching audiences in the millions to flagship AR launches with industry leaders — bringing craft and detail to every layer of the work.</p>
      </HomePillar>
    </div>
  </section>

  <!-- SECTION LINKS -->
  <section class="home-links">
    <div class="wrap">
      <a class="home-link" href="#about">/about</a>
      <a class="home-link" href="/experience">/experience</a>
      <a class="home-link" href="#process">/process</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO — full-bleed (no .wrap), flush under the navbar (page-top-gap 0, see
     is:global below), 75vh tall via a HOME-local --hero-height override (the
     shared token stays 85vh for ABOUT). The slideshow canvas already bakes the
     blue duotone via its treatment CONFIG — same look as the ABOUT .duo photos —
     so no .duo wrapper is needed here. Only bottom padding below. */
  .hero { --hero-height: 75vh; padding-bottom: var(--space-160); }
  /* Desktop/Large: contain the hero to the content width at a 16:9 box (inset,
     not edge-to-edge — matches the Figma direction). Tablet/Mobile (≤1279) keep
     the full-bleed 75vh box above. The canvas cover-crops to whatever box it gets. */
  @media (min-width: 1280px) {
    .hero-inner { max-width: var(--layout-max-width-desktop); margin: 0 auto; }
    .hero :global(.hero-frame) { height: auto; aspect-ratio: 16 / 9; min-height: 0; }
  }
  @media (min-width: 1800px) {
    .hero-inner { max-width: var(--layout-max-width-large); }
  }

  /* STATEMENT — divider line below removed per Figma (pillars begin with no rule
     above the first one). */
  .home-statement .wrap { padding: 0 0 var(--space-160); }
  .home-statement p {
    font-size: var(--font-size-h1);  /* bumped one role h2→h1 (#6); colour stays ink
                                        — dark prose with blue inline links */
    font-weight: var(--weight-h2);
    line-height: 1.4;
    color: var(--ink);
  }
  .home-statement p + p { margin-top: var(--space-32); }
  .home-statement .link {
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 1px;
    cursor: pointer;
  }

  /* PILLARS — wrapper spacing; pillar internals live in HomePillar.astro.
     Blue line at the top of the first pillar's header (same rhythm as the
     inter-pillar dividers / border-bottoms — Figma). */
  .pillars .wrap { padding: var(--space-64) 0 var(--space-96); }
  .pillars :global(.pillar:first-child) { border-top: var(--outline) solid var(--color-primary); }

  /* SECTION LINKS — keep the (large) gap up to the pillars; reduce the gap down
     to the footer; more spacing between the links themselves (Figma). */
  .home-links { padding: var(--space-240) 0 var(--space-96); }   /* bigger gap above the links (#4) */
  .home-links .wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-24);
  }
  .home-link {
    font-size: var(--font-size-button-large);  /* dedicated "large button" type
                                                  role, editable per breakpoint in
                                                  /styleguide (Figma) */
    font-weight: var(--font-weight-regular);
    color: var(--color-primary);
    line-height: var(--leading-tight);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-standard),
                padding-right var(--duration-standard) cubic-bezier(0.4, 0, 0.2, 1);
    letter-spacing: -0.01em;         /* optical tighten — no tracking token at this size */
  }
  .home-link:hover {
    opacity: 0.55;
    padding-right: var(--space-16);
  }

  /* Spacing tightens below desktop (standard 1279 breakpoint; mobile ≤800 inherits).
     Type sizes shift independently via the font-size tokens. */
  @media (max-width: 1279px) {
    .hero { padding-bottom: var(--space-128); }
    .home-statement .wrap { padding: 0 0 var(--space-128); }
    .pillars .wrap { padding: var(--space-48) 0 var(--space-64); }
    .home-links { padding: var(--space-160) 0 var(--space-64); }
  }
</style>

<style is:global>
  /* HOME hero is flush under the navbar (Figma): zero the site-wide
     page-top-gap for this route only. Set on .page-main itself — that's where
     global.css reads it for padding-top. */
  .page-main { --page-top-gap: 0; }
</style>
