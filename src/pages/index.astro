---
// index.astro — the HOME page. Ported from home-prototype_1.html, with the real
// tuned static-treatment slideshow (HomeSlideshow) in the hero placement instead
// of the prototype's plain crossfade placeholder. Navbar + footer come from
// BaseLayout; the standalone prototype's <nav>/<footer> markup is not ported.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSlideshow from '../components/HomeSlideshow.astro';
import HomePillar from '../components/HomePillar.astro';
---
<BaseLayout title="laurence-dawes.design">
  <!-- HERO SLIDESHOW — contained 16:9 on desktop/large (matches Figma, inset);
       full-bleed 75vh on tablet/mobile. -->
  <section class="hero">
    <div class="hero-inner"><HomeSlideshow /></div>
  </section>

  <!-- STATEMENT -->
  <section class="home-statement">
    <div class="wrap">
      <p>An award-winning design leader working at the juncture of <span class="link">design</span>, <span class="link">technology</span> &amp; <span class="link">strategy</span>.</p>
      <p>Currently working with AI &amp; XR technology, Laurence has built many groundbreaking products and experiences together with industry leaders such as <span class="link">LEGO</span>, <span class="link">Google</span>, <span class="link">Disney</span>, <span class="link">Bose</span> and <span class="link">Niantic</span>, to name a few.</p>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="pillars">
    <div class="wrap">
      <h3 class="pillars-label">Learn more</h3>
      <HomePillar heading="/design_leadership" image="/Workshop2.webp">
        <p>Two decades leading multi-disciplinary teams across LEGO, Trigger XR and AI/XR-native organisations — taking ideas from earliest concept through to global launch. Building creative cultures, mentoring talent, and shaping product vision in spaces where the technology often hasn't been invented yet.</p>
      </HomePillar>

      <HomePillar heading="/strategy" image="/Spectator1.webp">
        <p>Connecting emerging technology to brand opportunity. Building innovation roadmaps for partners including Bose, Niantic and Google — finding where R&amp;D capability, audience need and commercial reality intersect, and turning that into work that ships.</p>
      </HomePillar>

      <HomePillar heading="/product_&_experience" image="/Coach1.webp">
        <p>Hands-on design of physical play products, AR experiences and immersive installations. From LEGO toy lines reaching audiences in the millions to flagship AR launches with industry leaders — bringing craft and detail to every layer of the work.</p>
      </HomePillar>
    </div>
  </section>

  <!-- SECTION LINKS -->
  <section class="home-links">
    <div class="wrap">
      <a class="home-link reveal" href="#about">/about</a>
      <a class="home-link reveal" href="/experience">/experience</a>
      <a class="home-link reveal" href="#process">/process</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO — per the Figma designer notes:
       • Tablet/Mobile (≤1279): full edge-to-edge width, flush under the navbar
         (page-top-gap 0, see is:global below), 75vh tall; the canvas cover-crops
         within the frame.
       • Desktop/Large (≥1280): the hero MAINTAINS its 16:9 aspect at 75vh height,
         so the width follows the aspect and may break outside the body width —
         centred, overflow clipped. A 64px gap sits below the navbar.
     75vh comes from a HOME-local --hero-height override (ABOUT's shared token
     stays 85vh). The slideshow canvas already bakes the blue duotone via its
     treatment CONFIG (same look as the ABOUT .duo photos), so no .duo wrapper. */
  .hero { --hero-height: 75vh; padding-bottom: var(--space-160); }
  @media (min-width: 1280px) {
    .hero { display: flex; justify-content: center; overflow: hidden; }
    .hero-inner {
      width: calc(75vh * 16 / 9);                          /* natural width at 75vh, 16:9 */
      max-width: calc(100vw - 2 * var(--hero-gap, 64px));  /* keep ≥ --hero-gap margin each side */
      aspect-ratio: 16 / 9;                                /* height derives from the (capped) width */
      flex: none;
    }
    .hero :global(.hero-frame) { height: 100%; min-height: 0; }
  }

  /* STATEMENT — divider line below removed per Figma (pillars begin with no rule
     above the first one). */
  .home-statement .wrap { padding: 0 0 var(--space-240); }   /* bigger gap statement → pillars (#2) */
  .home-statement p {
    font-size: var(--font-size-h1);  /* bumped one role h2→h1 (#6); colour stays ink
                                        — dark prose with blue inline links */
    font-weight: var(--weight-h2);
    line-height: 1.4;
    color: var(--ink);
  }
  .home-statement p + p { margin-top: var(--space-32); }
  .home-statement .link {
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 1px;
    cursor: pointer;
  }

  /* PILLARS — wrapper spacing; pillar internals live in HomePillar.astro.
     Blue line at the top of the first pillar's header (same rhythm as the
     inter-pillar dividers / border-bottoms — Figma). */
  .pillars .wrap { padding: var(--space-64) 0 var(--space-96); }
  /* "Learn more" heading above the expandable pillars (#3 / #2 — an h3). */
  .pillars-label {
    font-size: var(--font-size-h3);
    font-weight: var(--weight-h3);
    line-height: var(--leading-h3);
    color: var(--text-h3);
    margin-bottom: var(--space-32);
  }
  .pillars :global(.pillar:first-child) { border-top: var(--outline) solid var(--color-primary); }

  /* SECTION LINKS — keep the (large) gap up to the pillars; reduce the gap down
     to the footer; more spacing between the links themselves (Figma). */
  .home-links { padding: var(--space-240) 0 var(--space-96); }   /* bigger gap above the links (#4) */
  .home-links .wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-24);
  }
  .home-link {
    font-size: var(--font-size-button-large);  /* dedicated "large button" type
                                                  role, editable per breakpoint in
                                                  /styleguide (Figma) */
    font-weight: var(--font-weight-regular);
    color: var(--color-primary);
    line-height: var(--leading-tight);
    cursor: pointer;
    /* Hover shift uses transform (GPU-composited) rather than padding — animating
       padding reflows the row every frame, which is the glitch (#4). */
    transition: opacity var(--duration-fast) var(--ease-standard),
                transform var(--duration-standard) cubic-bezier(0.4, 0, 0.2, 1);
    letter-spacing: -0.01em;         /* optical tighten — no tracking token at this size */
  }
  .home-link:hover {
    opacity: 0.55;
    transform: translateX(calc(-1 * var(--space-16)));   /* right-aligned → shifts left */
  }
  /* Link reveals (site-wide .reveal — see global.css): a base delay so the fade
     reads deliberately rather than instantly, then a stagger down the three. */
  .home-link { --reveal-delay: 0.2s; }
  .home-link:nth-child(2) { --reveal-delay: 0.32s; }
  .home-link:nth-child(3) { --reveal-delay: 0.44s; }

  /* STATEMENT parallax: the .wrap is transformed by the script; promote it so the
     scroll-linked transform/opacity stay smooth. Only while the script is active. */
  .home-statement .wrap.parallax-on { will-change: transform, opacity; }

  /* Spacing tightens below desktop (standard 1279 breakpoint; mobile ≤800 inherits).
     Type sizes shift independently via the font-size tokens. */
  @media (max-width: 1279px) {
    .hero { padding-bottom: var(--space-128); }
    .home-statement .wrap { padding: 0 0 var(--space-160); }
    .pillars .wrap { padding: var(--space-48) 0 var(--space-64); }
    .home-links { padding: var(--space-160) 0 var(--space-64); }
  }
</style>

<style is:global>
  /* HOME hero gap (Figma): flush under the navbar on Tablet/Mobile (0), with a
     64px gap on Desktop/Large. Set on .page-main itself — that's where global.css
     reads it for padding-top. */
  .page-main { --page-top-gap: 0; }
  @media (min-width: 1280px) {
    /* Desktop/Large: 64px gap below the navbar, and the hero keeps a matching
       64px minimum margin on its left/right (--hero-gap, read in .hero-inner). */
    .page-main { --hero-gap: 64px; --page-top-gap: var(--hero-gap); }
  }

  /* Statement starts hidden — applied via the <head> `reveal-ready` flag so it's
     in effect before first paint (no flash on tall/portrait windows where it'd
     otherwise be in view at load). The parallax script drives opacity + the
     slide-up transform from here. Reduced motion / no JS → no flag → visible. */
  html.reveal-ready .home-statement .wrap { opacity: 0; }
</style>

<script>
  // STATEMENT — slide-up + fade, then a gentle parallax. Keyed to scroll distance
  // from the TOP (not the element's viewport position), so it's ALWAYS hidden + low
  // at load no matter the window shape. The hero has no motion; pillars none.
  // Skipped under prefers-reduced-motion (and with no JS) — text just visible/static.
  // The SLIDE (motion) and the FADE (opacity) are fully independent:
  //   • SLIDE — its own slow scroll-distance (RISE_VH). Tune this freely; it can keep
  //     going as you read down the (tall) statement. No "finish before the top" limit.
  //   • FADE — tied to POSITION (FINISH_VH) so it's at full opacity before the top
  //     nears the navbar, on any window shape. This is the ONLY part with that limit:
  //     the top reaches the top in ~1 screen of scroll, so the fade can't be longer.
  const STMT = {
    SLIDE_START: 320,  // px the statement sits BELOW its resting place at load.
    RISE_VH: 2.4,      // SLIDE speed: slide-up over this fraction of a viewport of
                       // scroll — bigger = slower/longer motion (auto-capped to fit).
    FINISH_VH: 0.2,    // FADE completes when the statement's top reaches this fraction
                       // of the viewport from the top — fully faded before the navbar.
    SPEED: 0.88,       // parallax lag once the slide is done (<1 = slower rise).
    PARALLAX_VH: 1.0,  // bound the parallax lag over this much further scroll.
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector('.home-statement');
  const wrap = section?.querySelector('.wrap');

  if (!reduceMotion && section && wrap) {
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    wrap.classList.add('parallax-on');

    function update() {
      const vh = window.innerHeight;
      const y = window.scrollY;
      // SLIDE — its own slow scroll-distance, capped so it still completes within the
      // page's available scroll on very tall (short-scroll) windows.
      const cap = Math.max(1, document.documentElement.scrollHeight - vh) * 0.85;
      const riseDist = Math.min(vh * STMT.RISE_VH, cap);
      const slideP = clamp(y / riseDist, 0, 1);
      const slide = STMT.SLIDE_START * Math.pow(1 - slideP, 3);   // slide up, easing out

      // FADE — keyed to POSITION: completes as the statement's top (fixed by the layout
      // above it; unaffected by the wrap transform) reaches the finish line near the
      // top. Hidden at load (fadeP = 0 at scrollY 0) on any window shape.
      const docTop = section.getBoundingClientRect().top + y;
      const fadeDist = Math.max(vh * 0.4, docTop - vh * STMT.FINISH_VH);
      const fadeP = clamp(y / fadeDist, 0, 1);
      const opacity = fadeP * fadeP * (3 - 2 * fadeP);           // smoothstep

      // Gentle parallax once the slide is done.
      const past = clamp(y - riseDist, 0, vh * STMT.PARALLAX_VH);
      const lag = (1 - STMT.SPEED) * past;
      wrap.style.transform = `translate3d(0, ${slide + lag}px, 0)`;
      wrap.style.opacity = `${opacity}`;
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
