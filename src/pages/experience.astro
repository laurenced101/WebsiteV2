---
// experience.astro — the EXPERIENCE page (formerly /projects).
// Ported one-to-one from the v7 PROJECTS prototype (projects-d2-prototype_7.html),
// with the /projects -> /experience rename applied. Dossier above, project index
// below. Project data is hardcoded for now (Session 1); Session 2 swaps it for a
// build-time Notion fetch with no template changes.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects.generated.js';
import { clients } from '../data/clients.js';

// Resolve each curated client logo (src/assets/clients/) to its build-optimized
// asset, in manifest order. Files missing on disk are dropped (filter), so a
// stale manifest entry can't break the build.
const clientLogoFiles = import.meta.glob('../assets/clients/*.webp', { eager: true, import: 'default' });
const clientLogos = clients
  .map((c) => ({
    name: c.name,
    img: clientLogoFiles[`../assets/clients/${c.file}`],
    scale: c.scale,
    hideOnMobile: c.hideOnMobile,
  }))
  .filter((c) => c.img);
---
<BaseLayout title="/experience" active="experience">
  <!-- Statement -->
  <section class="statement">
    <div class="wrap">
      <h1>/experience</h1>
      <p>Two decades leading the design of <span class="accent">physical play, augmented reality and immersive experiences</span> — taking ideas from first concept to global launch for brands reaching audiences in the millions.</p>
    </div>
  </section>

  <!-- Disciplines -->
  <section class="section">
    <div class="wrap">
      <div class="section-label">Disciplines</div>
      <div class="disciplines-row">
        <div class="discipline"><div class="discipline-num">01</div><div class="discipline-title">Physical play</div><div class="discipline-desc">Toy and product systems developed for global children's brands.</div></div>
        <div class="discipline"><div class="discipline-num">02</div><div class="discipline-title">Augmented reality</div><div class="discipline-desc">Location-based and camera-driven experiences built for mobile.</div></div>
        <div class="discipline"><div class="discipline-num">03</div><div class="discipline-title">Immersive experience</div><div class="discipline-desc">Installations and spatial experiences for brand and retail.</div></div>
        <div class="discipline"><div class="discipline-num">04</div><div class="discipline-title">Innovation strategy</div><div class="discipline-desc">Technology roadmaps connecting emerging tech to brand goals.</div></div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section stats">
    <div class="wrap">
      <div class="section-label">By the numbers</div>
      <div class="stats-row">
        <div class="stat"><div class="stat-num">20+</div><div class="stat-label">Years designing play &amp; immersive experiences</div></div>
        <div class="stat"><div class="stat-num">100M+</div><div class="stat-label">People reached worldwide</div></div>
        <div class="stat"><div class="stat-num">15</div><div class="stat-label">Awards &amp; patents</div></div>
      </div>
    </div>
  </section>

  <!-- Client wall (placeholder cells for now) -->
  <section class="section clients">
    <div class="wrap">
      <div class="section-label">Selected partners &amp; clients</div>
      <div class="logo-grid">
        {clientLogos.map((c) => (
          <div class:list={['logo-cell', c.hideOnMobile && 'logo-hide-mobile']} style={c.scale ? `--logo-scale: ${c.scale};` : undefined}>
            <Image src={c.img} width={320} alt={c.name} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Index -->
  <section class="index">
    <div class="wrap">
      <div class="index-head">
        <h2>Selected &amp; public-facing work</h2>
        <p class="sub">A short, public view of the portfolio — confidential projects available to discuss on request.</p>
      </div>

      <div class="index-grid index-col-head">
        <div>Brand</div>
        <div>Project</div>
        <div>Discipline</div>
        <div>Year</div>
        <div></div>
      </div>

      <div id="project-list">
        {projects.map((p, i) => <ProjectRow project={p} idx={i} />)}
      </div>
    </div>
  </section>

  <!-- Bottom note -->
  <div class="bottom-note">
    <div class="wrap">Selected public-facing work — full portfolio available on request.</div>
  </div>
</BaseLayout>

<!-- `.index-grid` is global so the index column header (this page) and the project
     rows (ProjectRow component, separate style scope) share one column template. -->
<style is:global>
  .index-grid {
    display: grid;
    grid-template-columns: 180px 1fr 130px 50px 220px;
    column-gap: var(--space-24);
    align-items: center;
  }
  @media (max-width: 1279px) {
    .index-grid { grid-template-columns: 130px 1fr 100px 50px 160px; column-gap: var(--space-12); }
  }
</style>

<style>
  /* STATEMENT */
  /* Top gap comes from `.page-main` (global, same on every page); only bottom
     padding here. Vertical padding only — side gutters come from `.wrap` margins. */
  /* Bottom gap = padding-bottom (48) + Disciplines section padding-top (48) = 96,
     made symmetric with the title→lead gap (h1 margin-bottom 96) per the Figma. */
  .statement .wrap {
    padding-bottom: var(--space-48);
  }
  .statement h1 { font-size: var(--font-size-h1); font-weight: var(--weight-h1); color: var(--text-h1); line-height: var(--leading-h1); margin-bottom: var(--space-96); }
  .statement p { font-size: var(--font-size-h2); font-weight: var(--weight-h2); line-height: 1.4; letter-spacing: var(--tracking-h2); max-width: var(--measure-h2); }
  .statement .accent { color: var(--color-primary); }

  /* SECTIONS */
  /* Divider rules between dossier sections removed (per layout feedback) — the
     thick hard-rule before the index is now the only separator in the dossier. */
  .section .wrap { padding-block: var(--space-48); }
  .section.stats .wrap { padding-block: var(--space-64); }
  .section.clients .wrap { padding-top: var(--space-48); padding-bottom: var(--space-64); }
  .section-label {
    font-size: var(--font-size-label); font-weight: var(--weight-label);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--text-label); margin-bottom: var(--space-24);
  }

  /* DISCIPLINES */
  .disciplines-row { display: flex; gap: var(--space-24); }
  .discipline {
    flex: 1; border-top: var(--outline) solid var(--color-primary);
    padding-top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-12);
  }
  .discipline-num { font-size: var(--font-size-caption); color: var(--color-primary); }
  .discipline-title { font-size: var(--font-size-h3); font-weight: var(--weight-h3); color: var(--text-h3); }
  .discipline-desc { font-size: var(--font-size-caption); color: var(--text-caption); line-height: var(--leading-caption); }

  /* STATS */
  .stats-row { display: flex; gap: var(--space-24); }
  .stat { flex: 1; display: flex; flex-direction: column; gap: var(--space-8); }
  .stat-num { font-size: var(--font-size-display); font-weight: var(--weight-display); color: var(--text-display); line-height: var(--leading-display); letter-spacing: var(--tracking-display); }
  .stat-label { font-size: var(--font-size-caption); color: var(--text-caption); line-height: var(--leading-caption); }

  /* CLIENT WALL — data-driven from src/data/clients.js (curated logos).
     One CSS grid (5-up desktop, 3-up mobile). Logos are tight-cropped at varied
     aspect ratios, so we optically balance in-cell rather than forcing equal
     heights: contain within a capped height + width so wide wordmarks and square
     marks read at similar visual weight. (Caps are eyeballed against a render.) */
  .logo-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-16); }
  /* Tiles use the page surface (--surface, #F7F7F7) so the wall reads seamlessly
     rather than as boxed tiles. Per-logo `--logo-scale` (set inline from the
     manifest) bumps delicate marks; defaults to 1. */
  .logo-cell {
    height: 94px; background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-16);
  }
  .logo-cell :global(img) {
    width: auto; height: auto;
    max-width: calc(78% * var(--logo-scale, 1));
    max-height: calc(38px * var(--logo-scale, 1));
    object-fit: contain;
  }

  /* INDEX */
  /* No bottom padding: the bottom-note's symmetric padding-block below is the sole
     spacer between the last project and the footer, so the note sits centered in it. */
  .index .wrap { padding-top: var(--space-64); padding-bottom: 0; }
  .index-head {
    padding-bottom: var(--space-16);
    border-bottom: var(--outline) solid var(--color-primary);
    display: flex; flex-direction: column; gap: var(--space-12);
  }
  .index-head h2 { font-size: var(--font-size-h2); font-weight: var(--weight-h3); color: var(--text-h3); }
  .index-head .sub { font-size: var(--font-size-caption); color: var(--text-caption); line-height: var(--leading-caption); }

  .index-col-head {
    padding: var(--space-16) 0;
    border-bottom: 1px solid var(--color-primary);
    font-size: var(--font-size-label); font-weight: var(--weight-label);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--text-label);
  }

  /* BOTTOM */
  .bottom-note .wrap {
    padding-block: var(--space-96); text-align: center;
    font-size: var(--font-size-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; color: var(--text-label);
  }

  /* Display/heading sizes now resize via the font-size token aliases
     (Large 1800+, Tablet ≤1279, Mobile ≤800), so the old ≤900 font-size
     overrides for .statement h1/p and .stat-num are gone. */

  /* ===== MOBILE (≤800): single-column dossier + full-bleed card index =====
     (Figma node 101:846). Type sizes already shrink via tokens; this is layout
     reflow only. Card-level changes live in ProjectRow.astro / Slideshow.astro. */
  @media (max-width: 800px) {
    /* Dossier rows stack. Disciplines keep their per-cell top border, so stacked
       they read as the divider-separated list the mobile design shows. */
    .disciplines-row { flex-direction: column; gap: var(--space-24); }
    .stats-row { flex-direction: column; gap: var(--space-32); }
    /* Client wall → 3-up on mobile (5-up on desktop). Amazon is dropped here
       (hideOnMobile) so the 9 remaining logos form a clean 3×3. */
    .logo-grid { grid-template-columns: repeat(3, 1fr); }
    .logo-cell.logo-hide-mobile { display: none; }

    /* Mobile reintroduces dividers between dossier sections (desktop omits them);
       skip the clients section since the thick hard rule follows it. */
    .statement .wrap,
    .section .wrap { border-bottom: 1px solid var(--color-primary); }
    .section.clients .wrap { border-bottom: none; }

    /* Index: drop the table column header (cards have no columns) and let the
       card list run full-bleed past the 12px wrap gutter, while the index head
       and bottom note stay inset. */
    .index-col-head { display: none; }
    #project-list {
      margin-left: calc(-1 * var(--layout-margin-mobile));
      margin-right: calc(-1 * var(--layout-margin-mobile));
    }
  }
</style>

<script>
  // ===== Deck image lazy-loading =====
  // Deck frames ship with their src/srcset parked in data-* (see Slideshow.astro)
  // so collapsed panels cost zero bytes. Swap them in on first intent — hover
  // (pointerenter) prefetches so the deck is usually ready by the time the row is
  // clicked; the expand handler is the fallback for touch / no-hover. Idempotent.
  function loadDeck(project) {
    if (!project || project.dataset.deckLoaded) return;
    project.dataset.deckLoaded = '1';
    project.querySelectorAll('img.deck-img').forEach((img) => {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      if (img.dataset.src) img.src = img.dataset.src;
    });
  }

  // ===== Expand / collapse =====
  // Toggling `.expanded` on `.project` drives the panel open (CSS) and tells the
  // slideshow RAF (in Slideshow.astro) which tracks to auto-advance. On collapse,
  // reset the slideshow back to the first frame.
  document.querySelectorAll('.project-row').forEach((row) => {
    // Prefetch this row's deck the moment the pointer lands on it.
    row.addEventListener('pointerenter', () => loadDeck(row.parentElement));

    row.addEventListener('click', () => {
      const project = row.parentElement;
      loadDeck(project);
      const wasExpanded = project.classList.contains('expanded');
      // Collapse all (and reset their slideshows to position 0)
      document.querySelectorAll('.project.expanded').forEach((p) => {
        p.classList.remove('expanded');
        const track = p.querySelector('.panel-slideshow-track');
        if (track && track._state) {
          track._state.position = 0;
          track._state.endPauseStart = 0;
          track.classList.remove('snapping');
          track.style.transform = 'translateX(0px)';
        }
      });
      if (!wasExpanded) project.classList.add('expanded');
    });
  });
</script>
