---
// HomePillar.astro — one expandable pillar on HOME (used three times).
// Heading click toggles `.expanded`; pillars open independently (multiple can
// be open at once). The plus rotates 45° to an X, and the panel reveals via a
// grid-template-rows 0fr→1fr transition (both ported from the prototype).
//
// Body copy is passed as the default slot; the heading, image (a /public path),
// and CTA target come in as props.
const { heading, image, imageAlt = '', ctaHref = '/experience', ctaLabel = 'See full experience' } = Astro.props;
---
<div class="pillar">
  <h2 class="pillar-heading">{heading}</h2>
  <div class="pillar-panel">
    <div class="pillar-clip">
      <div class="pillar-inner">
        <div class="pillar-text">
          <slot />
          <a class="pillar-link" href={ctaHref}>{ctaLabel} →</a>
        </div>
        <div class="pillar-image">
          <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pillar { border-bottom: var(--outline) solid var(--color-primary); }
  .pillar-heading {
    font-size: var(--font-size-feature);
    font-weight: var(--font-weight-regular);
    color: var(--color-primary);
    cursor: pointer;
    padding: var(--space-48) 0;
    margin: 0;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding-left var(--duration-standard) var(--ease-standard),
                background var(--duration-standard) var(--ease-standard),
                color var(--duration-standard) var(--ease-standard);
  }
  /* Hover (collapsed) = full blue bar, white text, heading nudged right (Figma). */
  .pillar-heading:hover { background: var(--color-primary); color: var(--surface); padding-left: var(--space-24); }
  .pillar-heading:hover::after { color: var(--surface); }
  /* Hover while EXPANDED = the lighter blue (--expand-tint, as on /experience),
     no nudge, text/× stay blue (#3). More specific, so it overrides the above. */
  .pillar.expanded .pillar-heading:hover { background: var(--expand-tint); color: var(--color-primary); padding-left: 0; }
  .pillar.expanded .pillar-heading:hover::after { color: var(--color-primary); }
  .pillar-heading::after {
    content: "+";
    font-size: var(--font-size-feature);  /* toggle scales with the heading */
    font-weight: var(--font-weight-light);
    color: var(--color-primary);
    transition: transform var(--duration-standard) var(--ease-standard),
                color var(--duration-standard) var(--ease-standard);
    line-height: 1;
  }
  /* Open = the white DEFAULT look (NOT blue), with the + rotated to × (Figma).
     Blue is reserved for hover only. */
  .pillar.expanded .pillar-heading::after { transform: rotate(45deg); }

  .pillar-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-slow) var(--ease-standard);
  }
  .pillar.expanded .pillar-panel { grid-template-rows: 1fr; }
  .pillar-clip { overflow: hidden; }
  .pillar-inner {
    padding: 0 0 var(--space-48) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-48);
    align-items: start;
  }
  .pillar-text {
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    color: var(--ink);
  }
  .pillar-text :global(p) { margin-bottom: var(--space-32); }
  .pillar-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-primary);
    border-bottom: var(--outline) solid var(--color-primary);
    font-size: var(--font-size-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding-bottom: 2px;
    font-weight: var(--font-weight-medium);
    transition: gap var(--duration-fast) var(--ease-standard);
  }
  .pillar-link:hover { gap: var(--space-16); }
  .pillar-image {
    aspect-ratio: 4 / 3;
    background: var(--grey-bg);
    overflow: hidden;
  }
  .pillar-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  /* Heading + toggle sizes shift via the --font-size-feature token; these tiers
     are layout only, on the standard 1279 / 800 breakpoints. */
  @media (max-width: 1279px) {
    .pillar-heading { padding: var(--space-32) 0; }
  }
  @media (max-width: 800px) {
    .pillar-inner { grid-template-columns: 1fr; gap: var(--space-24); padding-bottom: var(--space-32); }
  }
</style>

<script>
  // Pillars expand independently — multiple open at once (per the prototype).
  // Astro bundles this script once even though the component repeats, so this
  // single querySelectorAll wires up every pillar on the page.
  document.querySelectorAll('.pillar-heading').forEach((heading) => {
    heading.addEventListener('click', () => {
      heading.parentElement.classList.toggle('expanded');
    });
  });
</script>
