---
// ProjectRow.astro — one project's index row + expandable panel.
// Ported one-to-one from the v7 PROJECTS prototype. Expand/collapse is wired
// at the page level (experience.astro) by toggling `.expanded` on `.project`.
//
// Note: the `.index-grid` column template is defined as a page-level global in
// experience.astro so the row aligns with the index column header.
import { Image } from 'astro:assets';
import Slideshow from './Slideshow.astro';
import { resolveImage } from '../lib/projectImages.js';

const { project, idx } = Astro.props;
const { brand, brandLogoPath, title, desc, discipline, year, role, body, thumb, images } = project;

// Resolve the stored paths to build-optimized assets. `cover` is the row
// thumbnail (Cover property); `slides` is the panel deck (Slideshow property).
const cover = resolveImage(thumb);
const slides = (images ?? []).map(resolveImage).filter(Boolean);
const logo = resolveImage(brandLogoPath);
---
<article class="project" data-idx={idx}>
  <div class="index-grid project-row">
    <div class="row-brand">
      <span class="brand-text">{brand}</span>
      {logo && (
        <Image class="brand-logo" src={logo} width={320} alt={`${brand} logo`} loading="lazy" />
      )}
    </div>
    <div class="row-project">
      <div class="row-title">{title}</div>
      <div class="row-desc">{desc}</div>
    </div>
    <div class="row-discipline">{discipline}</div>
    <div class="row-year">{year}</div>
    <div class="row-thumb">{cover && (
      <Image
        src={cover}
        widths={[160, 220, 330, 440]}
        sizes="(max-width: 900px) 160px, 220px"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}</div>
  </div>
  <div class="project-panel">
    <div class="panel-clip">
      <div class="panel-inner">
        <Slideshow images={slides} />
        <p class="panel-text">{body}</p>
        <div class="panel-meta">
          <span>Brand <strong>{brand}</strong></span>
          <span>Role <strong>{role}</strong></span>
          <span>Discipline <strong>{discipline}</strong></span>
          <span>Year <strong>{year}</strong></span>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* PROJECT ROW */
  .project { border-bottom: 1px solid var(--color-primary); }
  /* Taller rows give the title/desc clear breathing room top & bottom (they're
     vertically centred) and let the thumbnail render larger. */
  .project-row { min-height: 160px; cursor: pointer; transition: background var(--duration-fast) var(--ease-standard); }
  .project-row:hover { background: rgba(0, 0, 245, 0.025); }
  .project.expanded > .project-row { background: var(--expand-tint); }

  /* BRAND COLUMN */
  .row-brand { align-self: stretch; position: relative; }
  .brand-text {
    position: absolute; top: 50%; left: 0;
    transform: translateY(-50%);
    font-size: var(--font-size-label); font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--ink);
    transition: opacity var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }
  .brand-logo {
    position: absolute; top: 0; left: 0;
    height: 100%; max-width: 160px;
    object-fit: contain; object-position: left center;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
    pointer-events: none;
  }
  .project:hover .brand-text,
  .project.expanded .brand-text { opacity: 0; }
  .project:hover .brand-logo,
  .project.expanded .brand-logo { opacity: 1; }

  .row-project { min-width: 0; }
  .row-title { font-size: var(--font-size-h3); font-weight: var(--weight-h3); color: var(--text-h3); margin-bottom: var(--space-4); line-height: var(--leading-h3); }
  /* Clamp the description to 3 lines, truncating with an ellipsis past that. */
  .row-desc {
    font-size: var(--font-size-caption); color: var(--text-caption); line-height: var(--leading-caption);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
  }
  .row-discipline { font-size: var(--font-size-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--grey-mid); }
  .row-year { font-size: var(--font-size-caption); color: var(--text-caption); }

  /* THUMB */
  .row-thumb {
    align-self: stretch;
    background: var(--grey-bg);
    overflow: hidden;
    justify-self: end;
    width: 100%;
  }
  .row-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(0.9) brightness(0.95);
    transition: filter var(--duration-slow) var(--ease-standard);
  }
  .project:hover .row-thumb img,
  .project.expanded .row-thumb img { filter: none; }

  /* EXPANDED PANEL */
  .project-panel {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--expand-tint);
    transition: grid-template-rows var(--duration-slow) var(--ease-standard);
  }
  .project.expanded .project-panel { grid-template-rows: 1fr; }
  .panel-clip { overflow: hidden; }
  .panel-inner { padding: var(--space-24) 0 40px 200px; }

  .panel-text {
    max-width: var(--measure-body);
    font-size: var(--font-size-body); line-height: var(--leading-body);
    color: var(--text-body);
    margin-bottom: var(--space-16);
  }
  .panel-meta {
    display: flex; gap: var(--space-32); flex-wrap: wrap;
    font-size: var(--font-size-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; color: var(--grey-mid);
  }
  /* `strong` keeps `--ink` (emphasis/value) so it stays distinct from the
     greyed `.panel-meta` label it sits inside — not conformed to a role colour. */
  .panel-meta span strong { color: var(--ink); font-weight: var(--weight-label); margin-left: var(--space-8); }

  @media (max-width: 900px) {
    .brand-logo { max-width: 120px; }
    /* .row-thumb width is 100% of its (narrower) grid column at this breakpoint. */
    .panel-inner { padding-left: 150px; }
  }
</style>
