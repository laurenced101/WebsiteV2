---
// ProjectRow.astro — one project's index row + expandable panel.
// Ported one-to-one from the v7 PROJECTS prototype. Expand/collapse is wired
// at the page level (experience.astro) by toggling `.expanded` on `.project`.
//
// Note: the `.index-grid` column template is defined as a page-level global in
// experience.astro so the row aligns with the index column header.
import { Image } from 'astro:assets';
import Slideshow from './Slideshow.astro';
import { resolveImage } from '../lib/projectImages.js';

const { project, idx } = Astro.props;
const { brand, brandLogoPath, title, desc, discipline, year, role, body, thumb, images } = project;

// Resolve the stored paths to build-optimized assets. `cover` is the row
// thumbnail (Cover property); `slides` is the panel deck (Slideshow property).
const cover = resolveImage(thumb);
const slides = (images ?? []).map(resolveImage).filter(Boolean);
const logo = resolveImage(brandLogoPath);
---
<article class="project" data-idx={idx}>
  <div class="index-grid project-row">
    <div class="row-brand">
      <span class="brand-text">{brand}</span>
      {logo && (
        <Image class="brand-logo" src={logo} width={320} alt={`${brand} logo`} loading="lazy" />
      )}
    </div>
    <div class="row-project">
      <div class="row-title">{title}</div>
      <div class="row-desc">{desc}</div>
    </div>
    <div class="row-discipline">{discipline}</div>
    <div class="row-year">{year}</div>
    <div class="row-thumb duo">{cover && (
      <Image
        src={cover}
        widths={[160, 220, 330, 440, 750]}
        sizes="(max-width: 800px) 100vw, (max-width: 1279px) 160px, 220px"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}</div>
  </div>
  <div class="project-panel">
    <div class="panel-clip">
      <div class="panel-inner">
        <Slideshow images={slides} />
        <p class="panel-text">{body}</p>
        <div class="panel-meta">
          <span>Brand <strong>{brand}</strong></span>
          <span>Role <strong>{role}</strong></span>
          <span>Discipline <strong>{discipline}</strong></span>
          <span>Year <strong>{year}</strong></span>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* PROJECT ROW */
  .project { border-bottom: 1px solid var(--color-primary); }
  /* Taller rows give the title/desc clear breathing room top & bottom (they're
     vertically centred) and let the thumbnail render larger. */
  .project-row { min-height: 160px; cursor: pointer; transition: background var(--duration-fast) var(--ease-standard); }
  .project-row:hover { background: rgba(0, 0, 245, 0.025); }
  .project.expanded > .project-row { background: var(--expand-tint); }

  /* BRAND COLUMN */
  .row-brand { align-self: stretch; position: relative; }
  .brand-text {
    position: absolute; top: 50%; left: 0;
    transform: translateY(-50%);
    font-size: var(--font-size-label); font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--ink);
    transition: opacity var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }
  /* Expanded/hover: the brand logo fills the FULL row height (Figma feedback:
     "logo needs to fill height of frame"), flush left, replacing the wordmark.
     The source assets are square tiles, so height:100% + width:auto keeps them
     square and row-tall. No max-width cap — a cap fights the square aspect and
     letterboxes the tile (it then no longer fills the height). It's absolutely
     positioned, so the tile sitting a touch wider than the brand column on
     narrower breakpoints doesn't affect the row layout. */
  .brand-logo {
    position: absolute; top: 0; left: 0;
    height: 100%; width: auto;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
    pointer-events: none;
  }
  .project:hover .brand-text,
  .project.expanded .brand-text { opacity: 0; }
  .project:hover .brand-logo,
  .project.expanded .brand-logo { opacity: 1; }

  .row-project { min-width: 0; }
  /* Title bumped one role up (h3 → h2): the desktop/tablet table row now shows
     just the title (description removed below), so it carries more weight. */
  /* Title is capped at 2 lines and truncated with an ellipsis — it must never
     run to 3 lines (Figma feedback). */
  .row-title {
    font-size: var(--font-size-h2); font-weight: var(--weight-h2);
    color: var(--text-h2); line-height: var(--leading-h2);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
    overflow: hidden;
  }
  /* Description is hidden in the desktop/tablet table (collapsed rows show title
     only); the mobile card layout re-enables it below (clamped to 3 lines). */
  .row-desc {
    font-size: var(--font-size-caption); color: var(--text-caption); line-height: var(--leading-caption);
    display: none;
  }
  .row-discipline { font-size: var(--font-size-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--grey-mid); }
  /* Year matches the discipline label's treatment (same size/tracking/colour) so
     "2014" no longer reads larger than "PRODUCT" (#5). */
  .row-year { font-size: var(--font-size-label); letter-spacing: var(--tracking-label); color: var(--grey-mid); }

  /* THUMB — blue duotone at rest (shared `.duo` utility), reveals to full colour
     on hover / when expanded. Reveal = restore the saturation knob to 1 AND fade
     the blend overlay out; both transition. (Was a flat grayscale filter before.) */
  .row-thumb {
    align-self: stretch;
    justify-self: end;
    width: 100%;
  }
  .row-thumb img {
    height: 100%;
    object-fit: cover;
    transition: filter var(--duration-slow) var(--ease-standard);
  }
  .row-thumb::after { transition: opacity var(--duration-slow) var(--ease-standard); }
  .project:hover .row-thumb,
  .project.expanded .row-thumb { --duo-saturation: 1; }
  .project:hover .row-thumb::after,
  .project.expanded .row-thumb::after { opacity: 0; }

  /* EXPANDED PANEL */
  .project-panel {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--expand-tint);
    transition: grid-template-rows var(--duration-slow) var(--ease-standard);
  }
  .project.expanded .project-panel { grid-template-rows: 1fr; }
  .panel-clip { overflow: hidden; }
  /* Bottom padding 40→48: slightly bigger gap before the next row (Figma). */
  .panel-inner { padding: var(--space-24) 0 var(--space-48) 200px; }

  .panel-text {
    max-width: var(--measure-body);
    font-size: var(--font-size-body); line-height: var(--leading-body);
    color: var(--text-body);
    /* Bigger gap between the slideshow deck and the body copy (Figma). */
    margin-top: var(--space-32);
    margin-bottom: var(--space-48);   /* more space before the meta details row (#6) */
  }
  .panel-meta {
    display: flex; gap: var(--space-32); flex-wrap: wrap;
    font-size: var(--font-size-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; color: var(--grey-mid);
  }
  /* `strong` keeps `--ink` (emphasis/value) so it stays distinct from the
     greyed `.panel-meta` label it sits inside — not conformed to a role colour. */
  .panel-meta span strong { color: var(--ink); font-weight: var(--weight-label); margin-left: var(--space-8); }

  @media (max-width: 1279px) {
    /* .row-thumb width is 100% of its (narrower) grid column at this breakpoint. */
    .panel-inner { padding-left: 150px; }
  }

  /* ===== MOBILE (≤800): image-led card (Figma node 101:846) =====
     The desktop table row reflows into a stacked card: full-bleed thumbnail on
     top, then a meta block (brand+year row, title, description, discipline).
     Items are placed by grid-area, so their desktop DOM order doesn't matter.
     20px is the card's inner gutter and 250px the thumb height — both taken
     straight from the Figma frame; deliberate non-token values, like the
     desktop panel's 200px indent. */
  @media (max-width: 800px) {
    .project { border-bottom: 1px solid var(--color-primary); }
    .project-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "thumb thumb"
        "brand year"
        "title title"
        "disc  disc";
      column-gap: var(--space-12);
      row-gap: 0;
      min-height: 0;
      align-items: start;
    }
    .row-thumb { grid-area: thumb; width: 100%; height: 250px; align-self: start; }

    /* Brand: plain static text — no absolute centring, no hover logo on touch */
    .row-brand { grid-area: brand; position: static; padding: 20px 0 0 20px; }
    .brand-text { position: static; transform: none; }
    .brand-logo { display: none; }
    /* Keep the wordmark visible when expanded (desktop hides it for the logo,
       which we've removed on mobile). */
    .project:hover .brand-text,
    .project.expanded .brand-text { opacity: 1; }

    .row-year { grid-area: year; justify-self: end; padding: 20px 20px 0 0; }
    .row-project { grid-area: title; padding: var(--space-8) 20px 0; }
    /* Mobile cards re-show the description (hidden in the desktop table). */
    .row-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin-top: var(--space-4); }
    .row-discipline { grid-area: disc; padding: var(--space-8) 20px 20px; }

    /* Expanded reveal: drop the 200px desktop indent; pad to the card gutter */
    .panel-inner { padding: var(--space-16) 20px var(--space-24); }

    /* Metadata block → 2×2 grid, label stacked over value */
    .panel-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 20px var(--space-16); }
    .panel-meta span { display: flex; flex-direction: column; gap: var(--space-4); }
    .panel-meta span strong { margin-left: 0; }
  }
</style>
