---
// Footer.astro — Ticket 19 redesign.
// Desktop/Large: bordered box. Tablet/Mobile (≤1279): full-width top rule, no box.
// Circular LinkedIn + Mail icons; copy "© laurence dawes <year>" / "built with astro".
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-content">
      <p>© laurence dawes {year}</p>
      <div class="footer-icons">
        <a href="https://www.linkedin.com/in/laurence-dawes-101/" target="_blank" rel="noopener" class="footer-icon" aria-label="LinkedIn">
          <img src="/icons/linkedin.png" alt="" width="22" height="22" />
        </a>
        <a href="mailto:laurence.j.dawes@gmail.com" class="footer-icon" aria-label="Email">
          <img src="/icons/mail.png" alt="" width="22" height="22" />
        </a>
      </div>
      <div class="footer-rule"></div>
      <p>built with astro</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 0 0 var(--space-48); }
  .footer-content {
    border: var(--outline) solid var(--color-primary);
    background: var(--surface);
    padding: var(--space-24);
    display: flex; flex-direction: column; gap: var(--space-12);
  }
  /* Tablet/Mobile: drop the box for a full-width top rule. */
  @media (max-width: 1279px) {
    .footer-content {
      border: none;
      border-top: var(--outline) solid var(--color-primary);
      background: none;
      padding: var(--space-24) 0;
    }
  }
  /* Colour stays brand blue (deliberate — matches the blue-bordered footer box);
     line-height kept at 22px (the unitless leading scale would crush it). */
  .footer-content p { font-size: var(--font-size-label); letter-spacing: var(--tracking-label); color: var(--color-primary); font-weight: var(--weight-label); line-height: 22px; }
  .footer-icons { display: flex; gap: var(--space-12); align-items: center; }
  /* Real Figma badge icons (circular LinkedIn + Mail). They're black on transparent;
     the blue look is the Figma treatment — a #2e2ed8 overlay at mix-blend-mode:lighten,
     so the black circle reads blue and the white glyph + transparent corners stay light
     (blends with the footer/page surface behind, no isolation needed). */
  .footer-icon { width: 22px; height: 22px; position: relative; display: block; }
  .footer-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .footer-icon::after {
    content: ""; position: absolute; inset: 0;
    background: #2e2ed8; mix-blend-mode: lighten; pointer-events: none;
  }
  .footer-rule { width: 34px; height: 1px; background: var(--color-primary); }
</style>
